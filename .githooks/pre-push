#!/bin/sh
# Every-change gate before a push. Install once per clone:
#   git config core.hooksPath .githooks
# Bypass with `git push --no-verify`; CI runs the same commands either way.
set -e

# strata has zero runtime dependencies, so a fresh clone may have no toolchain.
if [ ! -x node_modules/.bin/tsc ]; then
  echo "strata pre-push: skipping checks, no dev toolchain (run: npm install)" >&2
  exit 0
fi

npm run --silent check
npm run --silent dead-code
npm test --silent

# Only this repo's tests run in CI. The reference check indexes repos that live
# outside it, so a fresh clone has no baseline and skips: record one with
#   node scripts/reference-index.mjs --write <repo>…
if [ -f .reference-baseline.json ]; then
  npm run --silent reference
else
  echo "strata pre-push: no reference baseline, skipping the real-repo check" >&2
fi
